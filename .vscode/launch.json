{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Clunexa (Server & Web App)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/dist/server.js",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3001"
      },
      "console": "integratedTerminal"
    }
  ]
}
